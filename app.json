{
  "expo": {
    "name": "tabi",
    "slug": "tabi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "tabi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tsito2602.tabi",
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "package": "com.tsito2602.tabi",
      "adaptiveIcon": {
        "backgroundColor": "#D7E2E8",
        "foregroundImage": "./assets/brand/icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF2F4",
          "image": "./assets/brand/icon.png",
          "imageWidth": 88
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
