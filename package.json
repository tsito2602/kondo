    "lucide-react": "^0.468.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "^7.1.0",
    "wrangler": "^4.92.0"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:connections && npm run test:sync && npm run test:pwa && npm run test:web && node --test scripts/test-workers-build.mjs && npm run build:web",
    "test:connections": "node scripts/test-flight-connections.mjs",
    "test:sync": "node scripts/test-travel-sync.mjs",
    "test:pwa": "node scripts/test-pwa-api.mjs && node scripts/test-service-worker.mjs && node scripts/test-icon-check.mjs",
    "test:web": "node scripts/test-web.mjs",
    "build:web": "vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "icons:export": "node scripts/export-brand.mjs",
    "format:check": "prettier --check src/web src/auth/auth-provider.tsx vite.config.ts scripts/test-web.mjs"
  },
  "private": true,
  "type": "module"
}
