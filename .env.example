# Public Google Web OAuth Client ID. Never put a client secret here.
VITE_GOOGLE_CLIENT_ID=
# Empty uses the same-origin /v1 API (proxied to localhost:8787 by Vite in development).
VITE_API_URL=
# Sample mode is always available in Vite development; enable only for staging builds.
VITE_ENABLE_DEMO=false
# Existing Workers Builds EXPO_PUBLIC_* public variables remain supported as aliases.
