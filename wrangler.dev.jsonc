{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabi-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/v1/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "tabi-local", "database_id": "00000000-0000-0000-0000-000000000001" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tabi-local-documents" }],
  "vars": { "GOOGLE_CLIENT_IDS": "", "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173" }
}
